# Vzor proměnných prostředí (bez hodnot). Skutečné hodnoty patří do .env mimo repozitář a do nastavení Vercelu.
DATABASE_URL=
# Náhodný řetězec aspoň 32 znaků, podepisuje odkaz na přehled (lib/token.ts).
DOWNLOAD_TOKEN_SECRET=
# Náhodný řetězec, Vercel ho posílá denní úloze /api/uklid (mazání starých otisků IP). Na Vercelu nastavit jako CRON_SECRET.
CRON_SECRET=
